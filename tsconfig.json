{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noImplicitThis": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app.ts",
    "data/**/*.ts",
    "pages/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "typings.d.ts"
  ]
}
