<view class="page quiz-page {{platformClass}}">
  <block wx:if="{{isReady}}">
    <view class="summary card">
      <view class="summary-head">
        <view class="course-title">{{title}}</view>
        <view class="muted">当前专题：{{currentTopicName}}</view>
      </view>
      <view class="summary-actions">
        <view class="summary-action">
          <button class="switch-btn" bindtap="goHome">切换课程</button>
        </view>
        <view class="summary-action">
          <button class="danger-btn reset-btn" bindtap="resetStats">重置</button>
        </view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat card">
        <view class="stat-value ok">{{rightNum}}</view>
        <view class="stat-label">正确</view>
      </view>
      <view class="stat card">
        <view class="stat-value bad">{{wrongNum}}</view>
        <view class="stat-label">错误</view>
      </view>
      <view class="stat card">
        <view class="stat-value">{{totalNum}}</view>
        <view class="stat-label">总题数</view>
      </view>
      <view class="stat card">
        <view class="stat-value">{{rateText}}</view>
        <view class="stat-label">正确率</view>
      </view>
    </view>

    <view class="actions card">
      <view class="count-head">
        <view class="count-title">题量</view>
        <view class="count-hint muted">作用于「专题 / 随机」练习；「试卷练习」固定 20 单选 + 10 判断 + 10 填空。</view>
      </view>
      <view class="count-row">
        <button class="count-btn {{questionCount === 1 ? 'active' : ''}}" data-count="1" bindtap="chooseCount">1 题</button>
        <button class="count-btn {{questionCount === 10 ? 'active' : ''}}" data-count="10" bindtap="chooseCount">10 题</button>
        <button class="count-btn {{questionCount === 20 ? 'active' : ''}}" data-count="20" bindtap="chooseCount">20 题</button>
        <button class="count-btn {{questionCount === 30 ? 'active' : ''}}" data-count="30" bindtap="chooseCount">30 题</button>
      </view>

      <view class="mode-grid">
        <button class="plain-btn mode-btn {{selectedAction === 'exam' ? 'action-selected' : ''}}" bindtap="startExam">试卷练习</button>
        <button class="plain-btn mode-btn pending" bindtap="showPendingMode">真题练习</button>
        <button class="plain-btn mode-btn {{selectedAction === 'topic-single' ? 'action-selected' : ''}}" data-mode="topic-single" bindtap="startPracticeByMode">专题单选</button>
        <button class="plain-btn mode-btn {{selectedAction === 'topic-judge' ? 'action-selected' : ''}}" data-mode="topic-judge" bindtap="startPracticeByMode">专题判断</button>
        <button class="plain-btn mode-btn {{selectedAction === 'topic-fill' ? 'action-selected' : ''}}" data-mode="topic-fill" bindtap="startPracticeByMode">专题填空</button>
        <button class="plain-btn mode-btn {{selectedAction === 'random-single' ? 'action-selected' : ''}}" data-mode="random-single" bindtap="startPracticeByMode">随机单选</button>
        <button class="plain-btn mode-btn {{selectedAction === 'random-judge' ? 'action-selected' : ''}}" data-mode="random-judge" bindtap="startPracticeByMode">随机判断</button>
        <button class="plain-btn mode-btn {{selectedAction === 'random-fill' ? 'action-selected' : ''}}" data-mode="random-fill" bindtap="startPracticeByMode">随机填空</button>
      </view>

      <view class="export-row">
        <button class="ghost-btn error-btn {{selectedAction === 'errors' ? 'action-selected' : ''}}" bindtap="showErrors">错题本</button>
        <button class="ghost-btn error-btn" bindtap="exportErrors">导出错题本</button>
        <button class="ghost-btn error-btn" bindtap="exportPaper">导出试卷</button>
      </view>
      <view wx:if="{{practiceActive}}" class="exam-progress">练习进度：{{practiceProgressText}}</view>
    </view>

    <view wx:if="{{showTopicPicker}}" class="topic-picker card">
      <view class="panel-title">选择专题</view>
      <view class="topic-grid">
        <button wx:for="{{topics}}" wx:key="key" class="{{item.buttonClass}}" data-topic="{{item.key}}" bindtap="switchTopic">
          {{item.name}}
        </button>
      </view>
    </view>

    <view class="progress card">
      <view class="progress-head">
        <view>{{currentTopicName}} 进度</view>
        <view class="muted">{{progressText}}</view>
      </view>
      <view class="progress-track">
        <view class="progress-bar" style="width: {{progressPercent}}%;"></view>
      </view>
    </view>

    <view wx:if="{{showSummary}}" class="result-summary card">
      <view class="panel-title">{{summaryTitle}}</view>
      <view class="summary-score">答对 {{summaryRight}} / {{summaryTotal}} 题 · 正确率 {{summaryRateText}}</view>
      <view class="muted summary-note">本次答错 {{summaryWrong}} 题，可到「错题本」回看解析。</view>
      <view class="result-actions">
        <button class="primary-btn result-btn" bindtap="retryPractice">再练一次</button>
        <button class="ghost-btn result-btn" bindtap="closeSummary">返回</button>
      </view>
    </view>

    <view wx:elif="{{showErrorBook}}" class="error-book card">
      <view class="panel-title">错题本</view>
      <view wx:if="{{hasNoErrors}}" class="empty muted">当前还没有错题。</view>
      <view wx:for="{{errorList}}" wx:key="id" class="error-item">
        <rich-text nodes="{{item.question}}"></rich-text>
        <view class="answer-line">正确答案：{{item.answer}}</view>
        <view wx:if="{{item.explain}}" class="explain-line">解析：{{item.explain}}</view>
        <view class="error-remove-row">
          <view class="error-remove-wrap">
            <button class="ghost-btn error-remove" data-index="{{index}}" bindtap="removeErrorItem">移除</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{currentQuestion}}" class="question card">
      <view class="question-meta">{{currentQuestion.topicName}} · {{currentQuestion.typeName}} · {{currentQuestion.difficulty || '中'}}</view>
      <rich-text class="question-text" nodes="{{currentQuestion.question}}"></rich-text>
      <view wx:if="{{currentQuestion.type === 'fill'}}" class="fill-box">
        <input class="fill-input" type="text" value="{{fillAnswer}}" bindinput="onFillInput" placeholder="请输入答案" disabled="{{answered}}" confirm-type="done" />
        <button class="primary-btn fill-submit" bindtap="submitFillAnswer" disabled="{{answered}}">提交答案</button>
      </view>
      <view wx:else class="option-list">
        <button wx:for="{{currentQuestion.options}}" wx:key="value" class="{{item.buttonClass}}" data-value="{{item.value}}" bindtap="answerQuestion" disabled="{{answered}}">
          <view class="option-mark">{{item.value}}</view>
          <text class="option-text">{{item.text}}</text>
        </button>
      </view>
      <view wx:if="{{answered}}" class="{{analysisClass}}">
        <view class="analysis-title">{{analysisTitle}}</view>
        <rich-text nodes="{{explanation}}"></rich-text>
      </view>
      <button wx:if="{{practiceActive && answered}}" class="primary-btn next-btn" bindtap="nextPracticeQuestion">{{nextButtonText}}</button>
    </view>

    <view wx:else class="empty-state card">
      <view class="panel-title">开始练习</view>
      <view class="muted">先选题量与练习方式：「试卷练习」出一整份卷；「专题单选 / 专题判断 / 专题填空」再选上方专题；「随机单选 / 随机判断 / 随机填空」全课程随机抽题。</view>
    </view>
  </block>

  <view wx:else class="empty-state card not-ready">
    <view class="panel-title">暂未加载题库</view>
    <view class="muted">{{readyMessage}}</view>
    <button class="primary-btn home-btn" bindtap="goHome">返回登录</button>
  </view>
</view>
