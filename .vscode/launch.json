{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OpenCV",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "arm64",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "/opt/homebrew/opt/opencv/lib"
                }
            ],
            "MIMode": "lldb",
            "internalConsoleOptions": "openOnSessionStart",
            // "preLaunchTask": "Build OpenCV4"
        },
        {
            "name": "Debug OpenCV on Windows",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "x86_64",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:SCOOP}\\apps\\msys2-cn\\current\\ucrt64\\bin\\gdb.exe",
            "internalConsoleOptions": "openOnSessionStart",
            // "preLaunchTask": "Build OpenCV4 on Windows"
        }
    ]
}
